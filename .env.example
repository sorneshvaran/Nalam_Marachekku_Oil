# Copy this file to the local env file and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Generate a unique secret for Auth.js and keep it only in your local/server environment.
AUTH_SECRET=""
# Set to true only when your deployment platform or proxy validates the host headers.
AUTH_TRUST_HOST=""
